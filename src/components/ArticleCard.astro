---
type Props = {
    article: {
        title: string;
        description: string;
        image: string;
        url: string;
        date: string;
    };
};

const { article } = Astro.props;
---

<a
    href={article.url}
    class="w-[100%] sm:w-[49%] p-5 bg-black/50 border border-[#202020] hover:scale-105 rounded-xl article transition-all duration-200 ease-in-out"
    style="box-shadow: 0px 0px 68.5px 0px rgba(107, 29, 180, 0.15);"
>
    <img
        src={article.image}
        class="w-full object-cover rounded-md aspect-video mb-4"
    />
    <div>
        <h2 class="font-medium text-sm md:text-base">{article.title}</h2>
        <p class="text-sm text-white/40">{article.description}</p>
        <p class="text-white/50 mt-3 text-right text-sm">{article.date}</p>
    </div>
</a>
