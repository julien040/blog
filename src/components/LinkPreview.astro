---
export interface Props {
    title: string;
    description: string;
    href: string;
}

const { href, title, description } = Astro.props;
---

<a href={href}>
    <div
        class="w-full flex gap-2 p-4 rounded-xl bg-gradient-to-bl from-[#a8c0ff] to-[#3f2b96] hover:opacity-90 transition-all duration-200 ease-in-out"
    >
        <div class="w-full">
            <div class="text-lg font-semibold">{title}</div>
            <div class="text-sm text-white/70">{description}</div>
        </div>

        <p>
            {">"}
        </p>
    </div>
</a>
