---
export interface Props {
  title: string;
  description: string;
  schema?: Object;
}
import NavBar from "../components/NavBar.astro";

const { title, description, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || "Julien C's Blog"}</title>
    <meta name="description" content={description} />
    <!-- To insert a Google Schema for articles -->
    {
      schema && (
        <script type="application/ld+json">{JSON.stringify(schema)}</script>
      )
    }
  </head>
  <body class="p-6 mx-auto min-h-screen">
    <style is:global>
      /* inter-regular - latin */
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 400;
        src: local(""),
          url("../fonts/inter-v12-latin-regular.woff2") format("woff2"),
          /* Chrome 26+, Opera 23+, Firefox 39+ */
            url("../fonts/inter-v12-latin-regular.woff") format("woff"); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        font-display: swap;
      }

      /* inter-500 - latin */
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 500;
        src: local(""),
          url("../fonts/inter-v12-latin-500.woff2") format("woff2"),
          /* Chrome 26+, Opera 23+, Firefox 39+ */
            url("../fonts/inter-v12-latin-500.woff") format("woff"); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        font-display: swap;
      }

      /* inter-600 - latin */
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 600;
        src: local(""),
          url("../fonts/inter-v12-latin-600.woff2") format("woff2"),
          /* Chrome 26+, Opera 23+, Firefox 39+ */
            url("../fonts/inter-v12-latin-600.woff") format("woff"); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        font-display: swap;
      }

      /* inter-700 - latin */
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 700;
        src: local(""),
          url("../fonts/inter-v12-latin-700.woff2") format("woff2"),
          /* Chrome 26+, Opera 23+, Firefox 39+ */
            url("../fonts/inter-v12-latin-700.woff") format("woff"); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        font-display: swap;
      }

      /* Define background color var */
      :root {
        --bg-color: #131618;
      }
      html {
        background-color: var(--bg-color);
      }
      body {
        max-width: 800px;
      }

      main {
        min-height: 74vh;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Inter", sans-serif;
        font-weight: 600;
        letter-spacing: -0.04em;
        transition: font-size 0.3s;
        color: white;
        opacity: 0.9;
      }
      p,
      button,
      a {
        font-family: "Inter", sans-serif;
        font-weight: 400;
        color: white;
        letter-spacing: -0.01em;
        transition: font-size 0.3s;
      }
      ul {
        list-style: disc;
        padding-inline-start: 16px;
        margin-left: 16px;
      }

      /* li {
        padding-inline-start: 12px;
      } */
      /* li::before {
        content: "-";
        margin-right: 12px;
      } */
    </style>
    <script async defer src="https://simple.julienc.me/latest.js"></script>
    <noscript
      ><img
        src="https://simple.julienc.me/noscript.gif"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      />
    </noscript>
    <div
            class="w-full bg-black text-amber-900 text-center p-4  mb-5 font-ui rounded-lg"
            >
            <div class="max-w-3xl mx-auto flex flex-col">
                <h1 class="text-md font-semibold tracking-tight">Available for an internship</h1>
                <p class="text-xs text-white/60">
                    I’m seeking a 6-month software engineering internship starting in January 2027. Based in France, I’m open to both remote roles and relocation. For any opportunities, please contact me at <a href="mailto:contact@julienc.me" class="underline text-white/80">
                        contact@julienc.me
                    </a> <br />
                    You can find my resume <a href="https://cdn.julienc.me/resume.pdf" class="underline text-white/80">here</a>.
                </p>
            </div>
            </div>
    <NavBar />
    <main>
      <slot />
    </main>
    <footer class="mt-6 text-left flex flex-col gap-4 rounded-xl p-5 bg-black/30 border border-white/10">
      <div class="flex gap-3">
        <a href="https://github.com/julien040">
          <svg
            width={20}
            height={20}
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="text-neutral-400"
          >
            <g clip-path="url(#a)">
              <path
                fill-rule="evenodd"
                fill="currentColor"
                clip-rule="evenodd"
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
              ></path>
            </g>
            <defs>
              <clipPath id="a">
                <path fill="#fff" d="M0 0h24v24H0z"></path>
              </clipPath>
            </defs>
          </svg>
        </a>
        <a href="https://x.com/JulienC_me">
                <svg
                    class="w-5 h-5 text-neutral-400"
                    viewBox="0 0 256 256"
                    xmlns="http://www.w3.org/2000/svg"
                    
                    ><path
                        fill="currentColor"
                        d="m218.12 209.56l-61-95.8l59.72-65.69a12 12 0 0 0-17.76-16.14l-55.27 60.84l-37.69-59.21A12 12 0 0 0 96 28H48a12 12 0 0 0-10.12 18.44l61 95.8l-59.76 65.69a12 12 0 1 0 17.76 16.14l55.31-60.84l37.69 59.21A12 12 0 0 0 160 228h48a12 12 0 0 0 10.12-18.44M166.59 204L69.86 52h19.55l96.73 152Z"
                    ></path>
                </svg>
            </a>
          <a href="https://news.ycombinator.com/user?id=julien040">
                <svg  
                viewBox="0 0 24 24" 
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-neutral-400"
                >
                  <path fill="currentColor" d="M0 24V0h24v24zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896z"/>
                </svg>
            </a>
      </div>
      <p class="text-white/40 text-sm">
        Created by Julien
        <br />
        Unless specified, all content is licensed under <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          class="text-white/50 text-sm"
        >
          CC BY-NC-SA 4.0</a
        >
      </p>
    </footer>
  </body>
</html>
